{
  "name": "kaisola-native",
  "version": "0.1.102",
  "private": true,
  "description": "Native Swift macOS and iPhone apps for Kaisola",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "code-editor:bundle": "rollup --config scripts/code-editor/rollup.config.mjs",
    "test:node": "node --test tests/node/*.test.cjs",
    "native:resource": "node scripts/native-resource-gate.cjs",
    "native:frame-trace": "node scripts/native-frame-trace-gate.cjs",
    "native:frame-cadence": "node scripts/native-frame-cadence-gate.cjs",
    "native:resource-fixture": "node scripts/native-resource-fixture-gate.cjs",
    "native:dev": "./scripts/native-dev.sh",
    "native:fast": "./scripts/native-fast.sh",
    "native:fast:build": "./scripts/native-fast.sh --build-only",
    "native:fast:launch": "./scripts/native-fast.sh --launch-only",
    "native:test:focus": "./scripts/native-test-fast.sh",
    "native:test:select": "node scripts/native-test-select.cjs",
    "native:test:changed": "./scripts/native-test-changed.sh",
    "native:timing": "node scripts/native-build-timing.cjs",
    "native:launch-smoke": "node scripts/native-launch-smoke.cjs",
    "native:catalog-smoke": "node scripts/native-catalog-smoke.cjs",
    "native:sign:distribution": "node scripts/native-distribution-sign.cjs",
    "native:preflight": "node scripts/native-release-preflight.cjs",
    "native:helper:download": "node scripts/download-native-node-runtime.cjs all",
    "native:helper:probe": "node scripts/native-broker-helper-probe.cjs",
    "release:fast": "node scripts/release-fast.cjs",
    "companion:sim": "./scripts/companion-simulator.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.205",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.62.4"
  }
}
